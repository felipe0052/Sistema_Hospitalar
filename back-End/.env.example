# Oracle DB (produção/homologação) — formato python-oracledb (thin mode):
# oracle+oracledb://USUARIO:SENHA@HOST:1521/?service_name=NOME_SERVICO
DATABASE_URL=sqlite:///./decos_intranet.db

SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# RN06 — upload de POPs/documentos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
